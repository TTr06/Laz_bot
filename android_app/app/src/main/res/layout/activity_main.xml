<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/laz_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_cart"
                android:contentDescription="LazBot"
                app:tint="@color/laz_orange" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LazBot Tracker"
                    android:textColor="@color/laz_text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cửa sổ nổi &amp; Giá cuối cùng 100%"
                    android:textColor="@color/laz_text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:backgroundTint="#2D3748"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="ĐANG TẮT"
                android:textColor="@color/laz_text_sub"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Overlay Permission Alert Banner -->
        <LinearLayout
            android:id="@+id/layoutOverlayWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_card"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Cần cấp quyền Cửa sổ nổi"
                android:textColor="@color/laz_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Để bong bóng hiển thị đè lên các ứng dụng khác, vui lòng bật quyền 'Xuất hiện trên cùng'."
                android:textColor="@color/laz_text_sub"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_button"
                android:text="Cấp quyền ngay"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Card: Cài đặt Telegram -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÀI ĐẶT THÔNG BÁO TELEGRAM"
                android:textColor="@color/laz_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bot Token (từ @BotFather):"
                android:textColor="@color/laz_text_sub"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBotToken"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="Ví dụ: 778899:AAH..."
                android:textColorHint="#4A5568"
                android:textColor="@color/laz_text_main"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat ID người nhận (từ @userinfobot):"
                android:textColor="@color/laz_text_sub"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etChatId"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="Ví dụ: 123456789"
                android:textColorHint="#4A5568"
                android:textColor="@color/laz_text_main"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnTestTelegram"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="#2D3748"
                android:text="Kiểm tra gửi tin Telegram"
                android:textColor="@color/laz_text_main"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card: Cài đặt Cookie Lazada & Tần suất -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÀI ĐẶT QUÉT LAZADA"
                android:textColor="@color/laz_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cookie Lazada (JSON hoặc dạng text):"
                android:textColor="@color/laz_text_sub"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etCookie"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:background="@drawable/bg_input"
                android:hint="Dán chuỗi Cookie hoặc JSON cookie tại đây..."
                android:textColorHint="#4A5568"
                android:textColor="@color/laz_text_main"
                android:textSize="12sp"
                android:padding="10dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tần suất quét giỏ hàng (phút):"
                android:textColor="@color/laz_text_sub"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etInterval"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:text="1"
                android:inputType="number"
                android:textColor="@color/laz_text_main"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Actions: Start/Stop -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button"
            android:text="🚀 BẬT BOT &amp; HIỆN CỬA SỔ NỔI"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Sau khi bật, một bong bóng nổi sẽ xuất hiện trên màn hình để bạn tiện theo dõi đa nhiệm."
            android:textColor="@color/laz_text_sub"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
