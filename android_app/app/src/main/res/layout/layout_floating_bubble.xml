<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <ImageView
        android:id="@+id/imgBubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble"
        android:contentDescription="LazBot Bubble"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_cart" />

    <!-- Huy hiệu chấm xanh biểu thị trạng thái đang hoạt động -->
    <View
        android:id="@+id/dotActive"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_bubble"
        android:backgroundTint="@color/success" />

</FrameLayout>
